# Optional override for the canonical host (no trailing slash). Without it,
# every production build uses https://alleanzainsurance.org for canonical
# links, Open Graph, robots.txt, sitemap.xml and structured data.
# NEXT_PUBLIC_SITE_URL=https://alleanzainsurance.org

# REQUERIDAS ANTES DE LANZAR. Ambos formularios (/api/contacto y
# /api/health/contact) envían cada solicitud por Resend a
# info@alleanzainsurance.org, con el correo del visitante como Reply-To.
# El remitente debe estar en el dominio verificado de Resend
# (RESEND_SENDING_DOMAIN, por defecto forms.alleanzainsurance.org); cualquier
# otro se trata como no configurado. Nunca uses la dirección del
# visitante como remitente.
#
# Sin estas variables los formularios responden 503 y avisan al visitante en
# lugar de recoger datos personales que no tienen a dónde ir.
RESEND_API_KEY=
RESEND_SENDING_DOMAIN=forms.alleanzainsurance.org
RESEND_FROM=Alleanza Insurance <website@forms.alleanzainsurance.org>

# Opcional: remitente distinto por formulario (sustituye a RESEND_FROM).
# CONTACT_FROM=
# HEALTH_CONTACT_FROM=

# Ledger interno de leads (sin datos personales del consumidor). Cada lead de
# seguros lleva un ID interno (LD-XXXXX-XXXXX) en el correo.
# LEAD_ID_SECRET: requerido en producción. Solo sirve para que el mismo envío
# reciba el mismo ID en cualquier instancia del servidor. No es una credencial
# del ledger.
# LEAD_LEDGER_ENDPOINT + LEAD_LEDGER_WEBHOOK_SECRET: con estas dos y
# LEAD_ID_SECRET, cada lead se registra en el ledger con un sobre firmado (HMAC)
# después de responder al visitante. Si falta cualquiera de las tres, o si el
# ledger falla, los formularios funcionan igual y el lead solo se envía por correo.
# Ver docs/measurement/lead-ledger.md.
# LEAD_ID_SECRET=
# LEAD_LEDGER_ENDPOINT=https://script.google.com/macros/s/…/exec
# LEAD_LEDGER_WEBHOOK_SECRET=
# LEAD_LEDGER_CAMPAIGN_IDS (no es secreto): IDs de campaña aprobados, separados
# por comas. Solo esas campañas pasan al ledger; las demás se omiten (el lead
# sigue normal y el correo muestra la campaña tal cual).
# LEAD_LEDGER_CAMPAIGN_IDS=aca_oe_2027,oe2027_texas_aca
# LEAD_LEDGER_SOURCE_IDS (no es secreto): fuentes propias aprobadas (IDs o
# dominios de referencia), separadas por comas, además de las fuentes
# integradas (google, meta, chatgpt…). Una fuente no registrada se omite del
# ledger junto con su medio y campaña; el lead sigue normal. Va separada de las
# campañas.
# LEAD_LEDGER_SOURCE_IDS=healthsherpa,partner_xyz,examplepartner.com

# Salud: Google Places (New) para mostrar reseñas verificadas en /health.
# GOOGLE_REVIEWS_URL puede ser el enlace público de tu ficha mientras agregas
# el Place ID y la clave de Places.
GOOGLE_REVIEWS_URL=https://www.google.com/maps/search/?api=1&query=Alleanza+Insurance+3424+Midcourt+Rd+Carrollton+TX
GOOGLE_REVIEWS_PLACE_ID=
GOOGLE_PLACES_API_KEY=
