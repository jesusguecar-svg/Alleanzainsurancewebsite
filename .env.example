# Absolute production URL, used for canonical links, Open Graph tags,
# robots.txt and sitemap.xml. No trailing slash.
#
# On Vercel this is optional: the project's production domain is picked up
# automatically from VERCEL_PROJECT_PRODUCTION_URL. Set this explicitly once a
# custom domain is attached, so canonical URLs point at the real domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# REQUERIDA ANTES DE LANZAR. Destino de los envíos del formulario de contacto:
# un webhook de tu CRM, proveedor de formularios o servicio de correo. El
# servidor reenvía los datos ahí; nunca se expone al navegador.
#
# Si no está configurada, /api/contacto responde 503 y el formulario muestra un
# aviso, en lugar de recoger datos personales que no tienen a dónde ir.
CONTACT_WEBHOOK_URL=

# Salud: Google Places (New) para mostrar reseñas verificadas en /health.
# GOOGLE_REVIEWS_URL puede ser el enlace público de tu ficha mientras agregas
# el Place ID y la clave de Places.
GOOGLE_REVIEWS_URL=https://www.google.com/maps/search/?api=1&query=Alleanza+Insurance+3424+Midcourt+Rd+Carrollton+TX
GOOGLE_REVIEWS_PLACE_ID=
GOOGLE_PLACES_API_KEY=

# Salud: envío del formulario a jesusg@alleanzainsurance.org mediante Resend.
# HEALTH_CONTACT_FROM debe ser una dirección verificada en tu dominio.
RESEND_API_KEY=
HEALTH_CONTACT_FROM=
